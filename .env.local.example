# Kopieer dit bestand naar .env.local voor lokaal testen van /admin
# (dit bestand zelf wordt genegeerd door git — vul echte waarden nooit
# hier in, wel in .env.local of in de environment variables van Vercel).

# Het wachtwoord dat het /admin-formulier vraagt.
ADMIN_PASSWORD=

# Fine-grained personal access token op github.com/settings/tokens,
# scope beperkt tot deze ene repo, permissie "Contents: Read and write".
GH_TOKEN=

# owner/repo, bv. Jessevdonck/bakkookboek
GH_REPO=
